# String de conexao do Neon (Dashboard > Connection Details > Connection string)
# Exemplo: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Usuário e senha do administrador inicial. APP_PASSWORD continua sendo usado
# para criar a primeira conta administrativa quando o banco ainda não tem usuários.
ADMIN_USERNAME=admin
APP_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessao (qualquer string longa e aleatoria)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Porta local (no Render e definida automaticamente)
PORT=3000
